APP_ENV=local
APP_DEBUG=true
APP_API_TOKEN=change-this-token-before-production

TENCENTCLOUD_SECRET_ID=replace_with_tencent_cloud_secret_id
TENCENTCLOUD_SECRET_KEY=replace_with_tencent_cloud_secret_key
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_IOT_ENDPOINT=iotexplorer.tencentcloudapi.com

